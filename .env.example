# Copy to .env on the server, fill in, then: chmod 600 .env
# Nothing in this file is ever committed (.gitignore blocks .env).

# paper = simulated orders on real market data (default, safe)
# live  = real orders. Only switch once the static-IP route is set up (plan Phase 5, step 5).
TRADING_MODE=paper

# Healthchecks.io ping URLs, one per platform (optional but recommended, Phase 6)
HC_PING_ZERODHA=
HC_PING_COINDCX=

# Zerodha Kite Connect (https://developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=

# CoinDCX API (https://coindcx.com/api-dashboard)
COINDCX_API_KEY=
COINDCX_API_SECRET=
